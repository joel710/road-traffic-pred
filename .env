# ═══════════════════════════════════════════════════════════════
# 🐳 DOCKER — LOCAL KAFKA (Default)
# ═══════════════════════════════════════════════════════════════
# For local development with docker compose, all services use
# the local Kafka broker. No external credentials needed.
#
# To use Aiven Cloud Kafka instead, create a .env.aiven file
# with your Aiven credentials and run:
#   docker compose --env-file .env --env-file .env.aiven --profile full up

KAFKA_HOST=kafka-4238954-kafka-2c1f.h.aivencloud.com
KAFKA_PORT=17498
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=
KAFKA_SSL_CERT=
KAFKA_SSL_KEY=

# ═══════════════════════════════════════════════════════════════
# 📊 KAFKA TOPICS
# ═══════════════════════════════════════════════════════════════
KAFKA_TOPIC_INPUT=flux_data
KAFKA_TOPIC_OUTPUT=traffic_predictions

# ═══════════════════════════════════════════════════════════════
# 🔌 API BACKEND
# ═══════════════════════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# ═══════════════════════════════════════════════════════════════
# ⚡ SPARK — Optimisé pour économie de ressources
# ═══════════════════════════════════════════════════════════════
# Container-internal paths (models mounted at /app/models)
MODEL_PATH=models/gnn_model.pth
SPARK_EXECUTOR_MEMORY=1g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_CORES=2
SPARK_SHUFFLE_PARTITIONS=4

# ═══════════════════════════════════════════════════════════════
# 📂 DATA & STREAMING
# ═══════════════════════════════════════════════════════════════
# Container-internal path (data mounted at /app/data)
CSV_PATH=data/test_gnn.csv
STREAM_DELAY=2.0
